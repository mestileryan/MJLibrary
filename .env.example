# Identifiants client OAuth publics (sans secret, flux PKCE), un par fournisseur.
# Copier ce fichier en .env.local et renseigner les valeurs : .env.local n'est pas versionné.
# Un fournisseur sans identifiant est simplement indisponible dans l'interface.
VITE_DROPBOX_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_ONEDRIVE_CLIENT_ID=
